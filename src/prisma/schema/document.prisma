model Document {
  id           String @id @default(uuid()) @db.Uuid
  originalName String
  size         Int?
  version      Int

  itemId String?
  key    String

  bucketName  String
  filePath    String
  contentType String

  isUploaded Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@map("documents")
}
