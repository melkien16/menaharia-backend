model ShipmentItem {
  id                   String    @id @default(uuid()) @db.Uuid
  shipmentId           String    @db.Uuid
  orderItemId          String?   @db.Uuid
  declaredValue        Decimal?  @db.Decimal(12, 2)
  itemNameSnapshot     String?   @db.VarChar(500)
  description          String    @db.Text
  quantity             Int
  temperatureSensitive Boolean   @default(false)
  weightKg             Decimal?  @db.Decimal(8, 2)
  lengthCm             Decimal?  @db.Decimal(8, 2)
  widthCm              Decimal?  @db.Decimal(8, 2)
  heightCm             Decimal?  @db.Decimal(8, 2)
  hazardous            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  deletedAt            DateTime?

  shipment  Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])

  @@map("shipment_items")
}
