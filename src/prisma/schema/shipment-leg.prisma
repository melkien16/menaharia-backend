enum ShipmentLegTypeEnum {
  pickup
  intercity
  hub_transfer
  last_mile
}

enum ShipmentLegStatusEnum {
  pending
  assigned
  in_transit
  completed
}

model ShipmentLeg {
  id               String                @id @default(uuid()) @db.Uuid
  shipmentId       String                @db.Uuid
  legType          ShipmentLegTypeEnum
  assignedDriverId String?               @db.Uuid
  origin           Unsupported("geography(Point, 4326)")?
  destination      Unsupported("geography(Point, 4326)")?
  status           ShipmentLegStatusEnum
  startedAt        DateTime?
  completedAt      DateTime?
  deletedAt        DateTime?

  shipment           Shipment   @relation("ShipmentToLegs", fields: [shipmentId], references: [id], onDelete: Cascade)
  assignedDriver     Driver?    @relation(fields: [assignedDriverId], references: [id])
  shippingCurrentLeg Shipment[] @relation("CurrentLegToShipment")

  @@map("shipment_legs")
}
