model Hub {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(255)
  address     String?
  city        String?   @db.VarChar(100)
  phone       String?
  capacity    Int?
  isActive    Boolean   @default(true)
  managerName String?
  managerId   String?   @unique @db.Uuid
  // location  Unsupported("geography(Point, 4326)")?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Hub staff relation - users assigned to this hub
  staff User? @relation("HubToStaff", fields: [managerId], references: [id], onDelete: SetNull)

  originShipments      Shipment[] @relation("OriginHubToShipment")
  destinationShipments Shipment[] @relation("DestinationHubToShipment")

  // Inter-city pricing relations
  originPricing      InterCityPricing[] @relation("OriginCityPricing")
  destinationPricing InterCityPricing[] @relation("DestinationCityPricing")

  @@map("hubs")
}
