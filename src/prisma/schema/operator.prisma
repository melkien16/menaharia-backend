model Operator {
  id                String         @id @default(uuid())
  companyName       String         @map("company_name")
  logo              String?        @map("logo")
  established       Int?           @map("established")
  rating            Float?         @map("rating")
  reliabilityScore  Int?           @map("reliability_score")
  badge             String[]       @map("badge")
  about             String?        @map("about")
  safetyInfo        String?        @map("safety_info")
  businessLicenseNo String         @unique @map("business_license_no")
  tinNo             String         @unique @map("tin_no")
  phone             String
  address           String
  status            partner_status @default(ACTIVE)
  responsibleName   String         @map("responsible_name")
  companyPhone      String         @map("company_phone")
  companyEmail      String         @unique @map("company_email")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  buses Bus[]
  disputes Dispute[]

  @@index([status])
  @@index([deletedAt])
  @@map("transport_partners")
}
