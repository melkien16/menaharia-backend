model Route {
  id          String    @id @default(uuid())
  code        String    @unique @map("code")
  origin      String
  destination String
  distance    Float
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  trips Trip[]

  @@index([origin, destination])
  @@map("routes")
}
