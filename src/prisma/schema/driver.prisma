enum DriverTypeEnum {
  internal
  external
}

enum ApprovalStatusEnum {
  pending
  approved
  rejected
}

model Driver {
  id                      String             @id @default(uuid()) @db.Uuid
  userId                  String             @unique @db.Uuid
  totalCompletedShipments Int                @default(0)
  rating                  Decimal            @default(0) @db.Decimal(3, 2)
  driverType              DriverTypeEnum
  approvalStatus          ApprovalStatusEnum
  licenseNumber           String?            @unique @db.VarChar(50)
  licenseFrontUrl         String?
  licenseBackUrl          String?
  licenseExpiryDate       DateTime?
  vehicleMake             String?
  vehicleModel            String?
  vehicleYear             Int?
  vehiclePlateNumber      String?            @unique @db.VarChar(20)
  vehicleType             String?
  vehicleFrontUrl         String?
  vehicleBackUrl          String?
  insurancePolicyNumber   String?
  insuranceExpiryDate     DateTime?
  insuranceUrl            String?
  bankName                String?
  bankAccountNumber       String?
  bankAccountHolderName   String?
  rejectionReason         String?
  approvedAt              DateTime?
  approvedBy              String?
  // currentLocation         Unsupported("geography(Point, 4326)")?
  lastLocationUpdate      DateTime?
  totalEarnings           Decimal            @default(0) @db.Decimal(14, 2)
  isActive                Boolean            @default(true)
  isAvailable             Boolean            @default(true)
  // Address fields
  experienceYears         Int?
  region                  String?
  city                    String?
  subCity                 String?
  woreda                  String?
  // Documents (references to Document model for presigned URL uploads)
  licenseFrontDocId       String?            @db.Uuid
  licenseBackDocId        String?            @db.Uuid
  vehicleFrontDocId       String?            @db.Uuid
  vehicleBackDocId        String?            @db.Uuid
  insuranceDocId          String?            @db.Uuid
  driverPhotoDocId        String?            @db.Uuid
  registrationDocId       String?            @db.Uuid

  driverPhoto     String?
  registrationDoc String?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  user         User                      @relation("UserToDriver", fields: [userId], references: [id])
  assignments  DriverVehicleAssignment[]
  shipmentLegs ShipmentLeg[]
  transactions Transaction[]

  @@map("drivers")
}
