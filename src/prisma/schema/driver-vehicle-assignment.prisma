enum AssignmentStatusEnum {
  active
  suspended
}

model DriverVehicleAssignment {
  id           String               @id @default(uuid()) @db.Uuid
  driverId     String               @db.Uuid
  vehicleId    String               @db.Uuid
  assignedAt   DateTime             @default(now())
  assignedById String               @db.Uuid
  status       AssignmentStatusEnum @default(active)
  deletedAt    DateTime?

  driver     Driver  @relation(fields: [driverId], references: [id])
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  assignedBy User    @relation("AssignedByToVehicleAssignment", fields: [assignedById], references: [id])

  @@map("driver_vehicle_assignments")
}
