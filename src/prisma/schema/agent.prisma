model ExternalAgent {
  id             String    @id @default(uuid()) @db.Uuid
  stationName    String    @db.VarChar(255)
  city           String    @db.VarChar(100)
  address        String?
  phone          String?
  ownerName      String    @db.VarChar(255)
  bankAccount    String?
  bankName       String?
  commissionRate Decimal   @default(5.0) @db.Decimal(5, 2)
  isActive       Boolean   @default(true)
  latitude       Decimal?  @db.Decimal(10, 8)
  longitude      Decimal?  @db.Decimal(11, 8)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Link to user account for login
  userId String? @db.Uuid
  user   User?   @relation("UserToExternalAgent", fields: [userId], references: [id], onDelete: SetNull)

  // Agent shipments
  agentShipments Shipment[] @relation("AgentShipments")

  // Agent commission records
  commissions AgentCommission[]

  // Transactions (agent commissions)
  transactions Transaction[]

  @@map("external_agents")
}

model AgentCommission {
  id             String           @id @default(uuid()) @db.Uuid
  agentId        String           @db.Uuid
  agent          ExternalAgent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  shipmentId     String?          @db.Uuid
  amount         Decimal          @db.Decimal(12, 2)
  commissionRate Decimal          @db.Decimal(5, 2)
  status         CommissionStatus @default(PENDING)
  paymentDate    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("agent_commissions")
}

enum CommissionStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}
