model Destination {
  id          String   @id @default(uuid())
  name        String
  description String
  image       String
  highlights  String[] @map("highlights")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("destinations")
}