enum ProductStatusEnum {
  draft
  active
  inactive
  suspended
}

model Product {
  id                     String            @id @default(uuid()) @db.Uuid
  vendorId               String            @db.Uuid
  name                   String            @db.VarChar(500)
  description            String?           @db.Text
  price                  Decimal           @db.Decimal(12, 2)
  vendorSettlementPrice  Decimal           @db.Decimal(12, 2)
  currency               String            @default("ETB") @db.VarChar(10)
  stockQuantity          Int               @default(0)
  categoryId             String?           @db.Uuid
  sku                    String?           @unique @db.VarChar(50) // Stock Keeping Unit (SKU): a human-readable alphanumeric code used for physical inventory management.
  isNobleStock           Boolean           @default(false)
  status                 ProductStatusEnum @default(active)
  averagePreparationTime Int               @default(0)
  weightKg               Decimal?          @db.Decimal(8, 2)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?

  vendor     Vendor           @relation(fields: [vendorId], references: [id])
  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]       @relation("ProductToCart")
  wishlist   WishlistItem[]   @relation("ProductToWishlist")

  @@map("products")
}
