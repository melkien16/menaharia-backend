enum TransactionTypeEnum {
  ORDER_PAYMENT // Customer paying for order
  COURIER_PAYMENT // Customer paying for courier request
  VENDOR_PAYOUT // Payout to vendor (after driver picks up)
  DRIVER_PAYOUT // Payout to external driver
  AGENT_COMMISSION // Commission to external agent
  REFUND // Refund to customer
  INTERNAL_DRIVER_COMMISSION // Commission for internal driver (via ERP)
}

enum TransactionStatusEnum {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

model Transaction {
  id          String                @id @default(uuid()) @db.Uuid
  txRef       String                @unique
  reference   String?               @unique
  amount      Decimal               @db.Decimal(12, 2)
  currency    String                @default("ETB")
  status      TransactionStatusEnum @default(PENDING)
  type        TransactionTypeEnum
  description String?

  // User who made the payment (for customer payments)
  userId String? @db.Uuid

  // Related entities
  orderId    String? @db.Uuid
  shipmentId String? @db.Uuid
  vendorId   String? @db.Uuid
  driverId   String? @db.Uuid
  agentId    String? @db.Uuid

  // Payment method used
  paymentMethod String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  user   User?          @relation("UserToTransactions", fields: [userId], references: [id])
  order  Order?         @relation(fields: [orderId], references: [id])
  vendor Vendor?        @relation(fields: [vendorId], references: [id])
  driver Driver?        @relation(fields: [driverId], references: [id])
  agent  ExternalAgent? @relation(fields: [agentId], references: [id])

  @@map("transactions")
}
